{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pengguna utama yang menyimpan informasi akun untuk sinkronisasi cloud.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "displayName", "createdAt", "updatedAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Pengaturan aplikasi pengguna termasuk pengingat harian dan tema.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "darkMode": {
          "type": "boolean"
        },
        "reminderEnabled": {
          "type": "boolean"
        },
        "reminderTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "reminderMessage": {
          "type": "string",
          "maxLength": 160
        },
        "currency": {
          "type": "string",
          "enum": ["IDR", "USD"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "darkMode", "reminderEnabled", "reminderTime", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Kategori pemasukan atau pengeluaran yang dapat dikustomisasi pengguna.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"]
        },
        "color": {
          "type": "string",
          "minLength": 4,
          "maxLength": 9,
          "pattern": "^#[0-9a-fA-F]{3,8}$"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "isDefault": {
          "type": "boolean"
        },
        "monthlyBudget": {
          "type": "number",
          "description": "Batas anggaran pengeluaran bulanan untuk kategori ini (IDR)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "name", "type", "color", "icon", "createdAt", "updatedAt"]
    },
    "WalletAccount": {
      "title": "WalletAccount",
      "description": "Simpanan atau rekening keuangan pengguna seperti dompet tunai, e-wallet (GoPay/OVO/DANA), atau rekening bank.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "kind": {
          "type": "string",
          "enum": ["cash", "ewallet", "bank", "savings"]
        },
        "initialBalance": {
          "type": "number"
        },
        "color": {
          "type": "string",
          "minLength": 4,
          "maxLength": 9,
          "pattern": "^#[0-9a-fA-F]{3,8}$"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "isDefault": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "name", "kind", "initialBalance", "color", "icon", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Catatan transaksi pemasukan, pengeluaran, atau transfer antar simpanan beserta catatan detail.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense", "transfer"]
        },
        "amount": {
          "type": "number"
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "walletId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "walletName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "toWalletId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toWalletName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "time": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Tunai", "Transfer Bank", "QRIS / E-Wallet", "Kartu Debit/Kredit"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "type", "amount", "categoryId", "categoryName", "date", "time", "note", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Dokumen profil pengguna terautentikasi."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserPreferences" },
      "description": "Preferensi pengguna seperti mode gelap dan pengingat harian."
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Kategori pemasukan/pengeluaran milik pengguna."
    },
    "/users/{userId}/wallets/{walletId}": {
      "schema": { "$ref": "#/entities/WalletAccount" },
      "description": "Simpanan atau rekening keuangan milik pengguna (Tunai, E-Wallet, Bank)."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Catatan transaksi keuangan harian milik pengguna."
    }
  }
}
